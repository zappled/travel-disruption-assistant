PORT=4000

# Claude credentials (needed for AI parsing + assessment; without them the API
# falls back to a rules-only assessment). Either:
#   a) run `ant auth login` once inside WSL (no key needed here), or
#   b) uncomment and set an API key below. Leave it commented out otherwise:
#      an empty value would override the CLI login.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override
# ANTHROPIC_MODEL=claude-opus-5-5

# Demo account, re-created on every API start (the user store is in-memory)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-please
