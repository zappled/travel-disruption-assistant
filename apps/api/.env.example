PORT=4000

# AI provider (needed for free-text parsing + AI assessment; without one the
# API falls back to a rules-only assessment). Checked in this order:
#
# 1. Claude (preferred). Either run `ant auth login` once inside WSL (no key
#    needed here), or uncomment and set an API key. Leave it commented out
#    otherwise: an empty value would override the CLI login.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
#
# 2. Gemini (free-tier fallback, used only when no Claude credentials exist).
#    Free key: https://aistudio.google.com/apikey
#    Note: free-tier prompts may be used by Google to improve its products.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Demo account, re-created on every API start (the user store is in-memory)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-please
